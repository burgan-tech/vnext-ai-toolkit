# Compose overlay for vnext-runtime (burgan-tech/vnext-runtime, vnext/docker) — adds the x-storage
# binding of the {{domain}} domain WITHOUT editing the vnext-runtime checkout. See etc/runtime/README.md.
#
#   cd <vnext-runtime>/vnext/docker
#   export VNEXT_DOMAIN_REPO=/absolute/path/to/this/domain/repo
#   docker compose -p vnext-{{domain}} --env-file ./domains/{{domain}}/.env \
#     -f docker-compose.yml -f "$VNEXT_DOMAIN_REPO/etc/runtime/docker-compose.blob.override.yml" \
#     --profile vnext up -d
#
# `command` replaces the sidecar's command, so it repeats vnext-runtime's flags and adds a second
# --resources-path plus --max-body-size 64Mi (the daprd default is far below a file upload).
# Re-check these flags when vnext-runtime changes its compose file.
services:
  vnext-orchestration-dapr:
    command: [
      "./daprd",
      "--app-id", "vnext-app-${DOMAIN_NAME:-core}",
      "--app-port", "5000",
      "--resources-path", "./components",
      "--resources-path", "/domain-components",
      "--max-body-size", "64Mi",
      "--dapr-grpc-port", "${DAPR_ORCHESTRATION_GRPC_PORT:-42111}",
      "--dapr-http-port", "${DAPR_ORCHESTRATION_HTTP_PORT:-42110}",
      "--scheduler-host-address", "dapr-scheduler:50007",
      "--placement-host-address", "dapr-placement:50005"
    ]
    volumes:
      - "${VNEXT_DOMAIN_REPO:?set VNEXT_DOMAIN_REPO to the domain repo path}/etc/runtime/dapr/components:/domain-components:ro"
      - "${VNEXT_DOMAIN_REPO:?set VNEXT_DOMAIN_REPO to the domain repo path}/data/blobs:/blobs"
  vnext-app:
    environment:
      # Only needed when a handle crosses flows (SubFlow input, a mapping copying a parent's file);
      # a flow's own x-storage bindings are always allowed.
      - FileStorage__AllowedBindings__0=vnext-blob-local
